           "arn:",
           {
            "Ref": "AWS::Partition"
           },
           ":iam::156041400555:root"
          ]
         ]
        }
       },
       "Resource": "*"
      },
      {
       "Action": [
        "kms:Encrypt*",
        "kms:Decrypt*",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:Describe*"
       ],
       "Condition": {
        "ArnLike": {
